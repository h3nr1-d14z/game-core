{
  "name": "@h3nr1-d14z/game-core",
  "version": "0.1.0",
  "description": "Engine-agnostic core for web games: fixed-timestep loop + polled input",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
